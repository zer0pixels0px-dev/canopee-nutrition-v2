------MultipartBoundary--bI6pchaEEdHRUZlmYw2CZa91a5zQw09U2PiWntgxCb----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.hydrotekhydroponics.com/static/version1788908392/frontend/MageMontreal/hydrotek/en_CA/css/print.css

@charset "utf-8";

.page-print .logo { display: block; float: none; text-align: left; }

@media print {
  * { background: transparent !important; color: rgb(0, 0, 0) !important; filter: none !important; text-shadow: none !important; }
  a, a:visited { text-decoration: underline !important; }
  pre, blockquote { border: 1px solid rgb(153, 153, 153); break-inside: avoid; }
  thead { display: table-header-group; }
  .table-wrapper table { width: 100%; table-layout: fixed; }
  .table-wrapper table td { width: auto; }
  .table-wrapper table > tfoot > tr:first-child { border-top: 1px solid rgb(153, 153, 153); }
  .box, tr, img { break-inside: avoid; }
  img { max-width: 100% !important; }
  @page { margin: 1cm; }
  .block-content, p, h2, h3 { orphans: 3; widows: 3; }
  .block-content { break-before: avoid; }
  .block-title, h2, h3 { break-after: avoid; }
  .nav-toggle { display: none !important; }
  .sidebar, .nav-sections, .header.content > [class], .panel.wrapper > [class], .footer.content > [class] { display: none; }
  .logo, .footer .copyright { margin: 10px 0px; display: block !important; }
  .order-details-items .order-items .order-gift-message:not(.expanded-content) { height: auto; visibility: visible; }
  .column.main { float: none !important; width: 100% !important; }
  .breadcrumbs { margin: 0px auto; text-align: right; }
  .footer.content { padding: 0px; }
  .hidden-print { display: none !important; }
}
